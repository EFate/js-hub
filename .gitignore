# ─────────────────────────────────────────────
# Python 通用副产物
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]          # 覆盖 .pyc / .pyo / .pyd
*$py.class
*.so

# 打包 / 分发 / 安装元数据
build/
dist/
*.egg-info/
*.egg
*.whl
pip-wheel-metadata/

# 类型检查 / 测试 / 覆盖率缓存
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
.cache/

# ─────────────────────────────────────────────
# 虚拟环境与依赖管理 (uv / pip)
# ─────────────────────────────────────────────
.venv/
venv/
env/

# ─────────────────────────────────────────────
# 环境变量 / 密钥（防止误提交）
# ─────────────────────────────────────────────
.env
.env.*
!.env.example

# ─────────────────────────────────────────────
# IDE / 编辑器 / 操作系统
# ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# 其他个人/临时工具目录
.pilotdeck/

# ─────────────────────────────────────────────
# 本项目副产物
# ─────────────────────────────────────────────
# 模型文件（体积大，通过 download_models 脚本获取，不入库）
models/

# 模型权重二进制（兜底：防止 .onnx 被误放到 models/ 之外而入库）
*.onnx

# 说话人注册表（运行时生成，含可识别人名 / 嵌入向量）
speakers.json

# 音频样例与识别输出（测试 / 运行时产生，非源码）
*.wav
*.mp3
*.flac
*.ogg

# 识别结果 / 运行日志（运行时产生，非源码）
result.txt
result*.txt
*.log
*.tmp

# ─────────────────────────────────────────────
# WorkBuddy 项目数据
# ─────────────────────────────────────────────
.workbuddy/


